{
  "openapi": "3.0.1",
  "info": {
    "title": "小区站长驾驶舱",
    "description": "小区站长驾驶舱接口文档",
    "contact": {
      "name": "management"
    },
    "version": "1.0"
  },
  "servers": [
    {
      "url": "http://172.31.128.135:8202/web",
      "description": "Generated server url"
    }
  ],
  "paths": {
    "/login/password": {
      "post": {
        "tags": [
          "登录"
        ],
        "summary": "账号密码登录",
        "operationId": "passwordLogin",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PasswordLoginDTO"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/BaseResponseLoginResultVO"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "PasswordLoginDTO": {
      "required": [
        "password",
        "phone"
      ],
      "type": "object",
      "properties": {
        "phone": {
          "type": "string",
          "description": "手机号",
          "refType": null
        },
        "password": {
          "type": "string",
          "description": "密码",
          "refType": null
        }
      },
      "description": "账号密码登录参数"
    },
    "BaseResponseLoginResultVO": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "level": {
          "type": "string"
        },
        "msg": {
          "type": "string"
        },
        "data": {
          "$ref": "#/components/schemas/LoginResultVO"
        }
      }
    },
    "LoginResultVO": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "description": "访问令牌",
          "refType": null
        },
        "refreshToken": {
          "type": "string",
          "description": "刷新令牌",
          "refType": null
        },
        "expireTime": {
          "type": "string",
          "description": "过期时间",
          "format": "date-time",
          "refType": null
        },
        "user": {
          "$ref": "#/components/schemas/LoginUserVO",
          "refType": "LoginUserVO"
        }
      },
      "description": "登录结果"
    },
    "LoginUserVO": {
      "type": "object",
      "properties": {
        "nickname": {
          "type": "string",
          "description": "昵称",
          "refType": null
        },
        "avatar": {
          "type": "string",
          "description": "头像",
          "refType": null
        },
        "gender": {
          "type": "integer",
          "description": "性别：0=未知，1=男，2=女",
          "format": "int32",
          "refType": null
        },
        "phone": {
          "type": "string",
          "description": "手机号",
          "refType": null
        },
        "userType": {
          "type": "integer",
          "description": "用户类型：3=小区站长，4=商户，5=物业",
          "format": "int32",
          "refType": null
        }
      },
      "description": "登录用户信息"
    }
  }
}
