          "description": "模型名称。为空时使用对应平台的默认图片模型。",
          "example": "gpt-image-2",
          "refType": null
        },
        "prompt": {
          "type": "string",
          "description": "图片生成提示词。描述希望生成的画面、风格、构图、主体和约束。",
          "example": "一条中国龙在云海中飞翔，国风水墨风格",
          "refType": null
        },
        "size": {
          "type": "string",
          "description": "输出图像比例，可选：auto、1:1、3:2、2:3、16:9、9:16、4:3、3:4、21:9、9:21、1:3、3:1、2:1、1:2",
          "example": "auto",
          "refType": null
        },
        "urls": {
          "type": "array",
          "description": "参考图片的URL，支持多张图片",
          "items": {
            "type": "string",
            "description": "参考图片的URL，支持多张图片"
          },
          "refType": "string"
