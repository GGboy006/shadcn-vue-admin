{
  "openapi": "3.0.1",
  "info": {
    "title": "小区站长驾驶舱",
    "description": "小区站长驾驶舱接口文档",
    "contact": {
      "name": "management"
    },
    "version": "1.0"
  },
  "servers": [
    {
      "url": "http://172.31.128.135:8202/web",
      "description": "Generated server url"
    }
  ],
  "paths": {
    "/agentScopeChat/chat/stream/completion": {
      "post": {
        "tags": [
          "AgentScope对话"
        ],
        "summary": "开始问答",
        "operationId": "completion_1",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatForm"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "ChatForm": {
      "type": "object",
      "properties": {
        "chatId": {
          "type": "integer",
          "description": "会话ID（为空则新建会话）",
          "format": "int64",
          "refType": null
        },
        "content": {
          "type": "string",
          "description": "消息内容",
          "refType": null
        },
        "messageType": {
          "type": "string",
          "description": "消息类型",
          "default": "text",
          "refType": null
        },
        "files": {
          "type": "array",
          "description": "附件文件列表（多模态场景：先调用uploadFile获取fileId）",
          "items": {
            "$ref": "#/components/schemas/FileItem"
          },
          "refType": "FileItem"
        }
      },
      "description": "AI对话表单"
    },
    "FileItem": {
      "required": [
        "fileId",
        "fileType"
      ],
      "type": "object",
      "properties": {
        "fileId": {
          "type": "string",
          "description": "LoongAI文件ID（uploadFile接口返回）",
          "refType": null
        },
        "fileType": {
          "type": "string",
          "description": "文件类型：image-图片 file-文件",
          "refType": null
        }
      },
      "description": "附件文件项"
    }
  }
}
